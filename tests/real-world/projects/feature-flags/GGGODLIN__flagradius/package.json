{
  "name": "flagradius",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mcp-guard": "node --import tsx src/mcp-guard.ts",
    "executor-daemon": "node --import tsx src/executor-daemon.ts",
    "demo": "bash scripts/run-live-e2e.sh --demo",
    "diagnose": "node --import tsx src/diagnose-cli.ts",
    "snapshot": "node --import tsx src/snapshot-cli.ts",
    "test:live-e2e": "bash scripts/run-live-e2e.sh"
  },
  "dependencies": {
    "@flagsmith/nodejs": "9.5.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@flagsmith/cli": "2.0.0",
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
