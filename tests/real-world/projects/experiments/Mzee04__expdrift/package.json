{
  "name": "expdrift",
  "version": "0.1.0",
  "description": "Pull-request guard for running Flagsmith experiments: flags event-name, identity and variation-key drift before it silently breaks your data.",
  "author": "Toyyib Olamilekan",
  "license": "MIT",
  "type": "module",
  "bin": {
    "expdrift": "dist/cli.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "check:demo": "node dist/cli.js check --base-dir examples/demo-shop --head-dir examples/demo-pr/bad --offline test/fixtures/flagsmith-snapshot.json",
    "selfhosted:up": "bash selfhosted/up.sh",
    "selfhosted:seed": "node selfhosted/seed.ts",
    "selfhosted:e2e": "bash selfhosted/e2e.sh",
    "selfhosted:traffic": "bash selfhosted/traffic.sh",
    "selfhosted:down": "bash selfhosted/down.sh",
    "cloud:e2e": "bash cloud/e2e.sh",
    "cloud:traffic": "bash cloud/traffic.sh"
  },
  "keywords": [
    "flagsmith",
    "experimentation",
    "a/b testing",
    "github-action",
    "feature-flags",
    "pull-request"
  ],
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
