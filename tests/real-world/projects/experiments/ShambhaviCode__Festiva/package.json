{
  "name": "festiva",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run typecheck && npm run test && npm run db:verify && npm run test:e2e && npm run test:integrations",
    "db:seed:generate": "tsx scripts/generate-seed.ts",
    "db:verify": "tsx scripts/verify-db.ts",
    "generate:globe": "node scripts/generate-globe-points.mjs",
    "perf": "node scripts/measure-performance.mjs",
    "package": "bash scripts/package.sh",
    "test:integrations": "playwright test -c playwright.integrations.config.ts",
    "integrations:check": "tsx scripts/check-integrations.ts",
    "stubs": "node tests/stubs/provider-stubs.mjs",
    "generate:map": "node scripts/generate-map-grid.mjs",
    "integrations:evidence": "tsx scripts/check-integrations.ts --evidence",
    "geo:build": "node scripts/build-geo.mjs"
  },
  "dependencies": {
    "@flagsmith/nodejs": "^9.4.0",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "d3-geo": "^3.1.2",
    "framer-motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jest": "^30.5.2",
    "mapshaper": "^0.6.102",
    "tailwindcss": "4.3.3",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "world-atlas": "^2.0.2"
  },
  "description": "FESTIVA: discover the world, celebrate every culture. Global festival discovery and AI-ready celebration planning.",
  "author": "Shambhavi M K",
  "engines": {
    "node": ">=20.9"
  }
}
