{
  "name": "shipcheck",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ShipCheck — instant GitHub repo & README readiness checker with a Flagsmith multivariate experiment.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
