{
  "name": "plattr",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "setup": "node scripts/setup.ts",
    "dev": "node --watch-preserve-output --watch-path=server --watch-path=shared --env-file-if-exists=.env server/main.ts --dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/main.ts",
    "serve": "npm run build && npm start",
    "check": "tsc -p tsconfig.json && tsc -p src/tsconfig.json && tsc -p e2e/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"server/**/*.test.ts\" \"shared/**/*.test.ts\" \"scripts/**/*.test.ts\" \"src/**/*.test.ts\"",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.ts",
    "vapid": "node scripts/vapid.ts",
    "flagsmith-setup": "node --env-file-if-exists=.env scripts/flagsmith-setup.ts",
    "icons": "node scripts/icons.ts",
    "record-fixtures": "node --env-file-if-exists=.env scripts/record-fixtures.ts",
    "load": "node --env-file-if-exists=.env scripts/load.ts",
    "test:e2e": "playwright test -c e2e"
  },
  "dependencies": {
    "@flagsmith/nodejs": "^9.5.0",
    "@hono/node-server": "^2.1.11",
    "better-sqlite3": "^13.2.0",
    "hono": "^4.13.21",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
