{
  "name": "experiment-doctor",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Finds the Flagsmith Experimentation setup bugs that make events disappear silently.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "tsx scripts/doctor.ts",
    "doctor:self": "tsx scripts/doctor-self.ts",
    "real-world": "tsx scripts/real-world.ts"
  },
  "dependencies": {
    "@babel/parser": "7.29.15",
    "@flagsmith/flagsmith": "12.6.0",
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@babel/types": "7.29.15",
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "fast-check": "4.11.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  }
}
