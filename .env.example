# Public client key for the Flagsmith environment (Development locally and on Vercel previews, Production on main)
NEXT_PUBLIC_FLAGSMITH_ENV_ID=
# Set to false in Vercel Production. Leave unset locally and in Preview to show the example by default.
NEXT_PUBLIC_SHOW_DEMO_BUTTON_DEFAULT=
# Server only. Organisation Settings > API Keys. Never prefix with NEXT_PUBLIC_.
FLAGSMITH_ADMIN_TOKEN=
# Filled in after the Production experiment is created
FLAGSMITH_EXPERIMENT_ID=
# Production environment key (used by scripts that call the Admin API)
FLAGSMITH_ENV_KEY=
# Optional: Admin API base URL (default https://api.flagsmith.com/api/v1/; change only for self-hosted)
FLAGSMITH_ADMIN_API_URL=
